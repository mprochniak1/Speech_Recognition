   "source": [
    "nagrania = {}\n",
    "for nazwa in OPIS:\n",
    "    y, sr = librosa.load(f\"{nazwa}.mp3\", sr=SR, mono=True)\n",
    "    nagrania[nazwa] = y\n",
    "    print(f\"{OPIS[nazwa]}: {len(y)} próbek, {sr} Hz, {len(y) / sr:.2f} s\")\n",
    "    display(Audio(y, rate=sr))"
   ]
