   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "import librosa.display\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import Audio, display\n",
    "\n",
    "SR = 16000\n",
    "N_FFT = 512\n",
    "HOP_LENGTH = 160\n",
    "N_MELS = 64\n",
    "N_MFCC = 13\n",
    "\n",
    "OPIS = {\n",
    "    \"a\": \"samogłoska „a”\",\n",
    "    \"muzyka\": \"wyraz „muzyka”\",\n",
    "    \"zdanie\": \"zdanie\",\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5e87813b",
   "metadata": {},
   "source": [
