    "FRAGMENTY = {\n",
    "    \"„a” - samogłoska\": (\"a\", 0.20, 0.30),\n",
    "    \"„a” - muzyka\": (\"muzyka\", 0.64, 0.76),\n",
    "    \"„a” - mały\": (\"zdanie\", 0.26, 0.32),\n",
    "    \"„a” - zobaczył\": (\"zdanie\", 2.08, 2.13),\n",
    "    \"„u” - muzyka\": (\"muzyka\", 0.24, 0.34),\n",
    "    \"„y” - muzyka\": (\"muzyka\", 0.46, 0.51),\n",
    "    \"„ś” - głośno\": (\"zdanie\", 0.85, 0.89),\n",
    "    \"„sz” - szczekał\": (\"zdanie\", 1.00, 1.07),\n",
    "    \"„z” - muzyka\": (\"muzyka\", 0.38, 0.44),\n",
    "    \"cisza\": (\"a\", 1.00, 1.50),\n",
    "}\n",
    "\n",
    "wiersze = {}\n",
    "for opis, (nazwa, t0, t1) in FRAGMENTY.items():\n",
    "    M = cechy[nazwa][1]\n",
    "    k0, k1 = librosa.time_to_frames([t0, t1], sr=SR, hop_length=HOP_LENGTH)\n",
    "    wiersze[opis] = M[:5, k0:k1 + 1].mean(axis=1)\n",
    "\n",
    "tabela = pd.DataFrame(wiersze, index=[f\"c{i}\" for i in range(5)]).T\n",
    "display(tabela.astype(float).round(1))"
   ]
