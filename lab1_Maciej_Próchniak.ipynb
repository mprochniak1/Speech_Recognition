  {
   "cell_type": "markdown",
   "id": "5a21b630",
   "metadata": {},
   "source": [
    "## 2. Log-mel i MFCC\n",
    "\n",
    "MFCC są liczone z tej samej macierzy log-mel (64 pasma, `ref=np.max`), więc obie reprezentacje mają tę samą oś czasu."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a4eb92ea",
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "samogłoska „a”: log-mel (64, 183), MFCC (13, 183), mowa od 0.16 do 0.44 s\n",
      "wyraz „muzyka”: log-mel (64, 183), MFCC (13, 183), mowa od 0.17 do 0.86 s\n",
      "zdanie: log-mel (64, 362), MFCC (13, 362), mowa od 0.16 do 2.77 s\n"
     ]
    }
   ],
   "source": [
    "def log_mel(y, n_fft=N_FFT, hop_length=HOP_LENGTH):\n",
    "    S = librosa.feature.melspectrogram(\n",
    "        y=y, sr=SR, n_fft=n_fft, hop_length=hop_length, n_mels=N_MELS\n",
    "    )\n",
    "    return librosa.power_to_db(S, ref=np.max)\n",
    "\n",
    "\n",
    "def mfcc(S_db):\n",
    "    return librosa.feature.mfcc(S=S_db, n_mfcc=N_MFCC)\n",
    "\n",
    "\n",
    "def granice_mowy(y):\n",
    "    przedzial = librosa.effects.trim(y, top_db=40, frame_length=N_FFT,\n",
    "                                     hop_length=HOP_LENGTH)[1]\n",
    "    return przedzial / SR\n",
    "\n",
    "\n",
    "def zakres_wykresu(y):\n",
    "    start, stop = granice_mowy(y)\n",
    "    return start - 0.05, stop + 0.05\n",
    "\n",
    "\n",
    "cechy = {}\n",
    "for nazwa, y in nagrania.items():\n",
    "    S_db = log_mel(y)\n",
    "    M = mfcc(S_db)\n",
    "    cechy[nazwa] = (S_db, M)\n",
    "    start, stop = granice_mowy(y)\n",
    "    print(f\"{OPIS[nazwa]}: log-mel {S_db.shape}, MFCC {M.shape}, \"\n",
    "          f\"mowa od {start:.2f} do {stop:.2f} s\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a41be83b",
   "metadata": {},
   "source": [
    "## 3. Przebieg czasowy, log-mel i MFCC\n",
    "\n",
    "Oś czasu obejmuje fragment z mową, dalej w nagraniach jest tylko cisza. Skala barw MFCC jest dopasowana do współczynników 1-12, współczynnik 0 wychodzi poza nią."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "f5cc821a",
   "metadata": {},
   "outputs": [
    {
     "output_type": "display_data",
     "data": {
      "text/plain": [
       "<Figure size 1100x900 with 6 Axes>"
      ],
      "image/png": "\n"
     },
     "metadata": {}
    },
    {
     "output_type": "display_data",
     "data": {
      "text/plain": [
       "<Figure size 1100x900 with 6 Axes>"
      ],
      "image/png": "\n"
     },
     "metadata": {}
    },
    {
     "output_type": "display_data",
     "data": {
      "text/plain": [
       "<Figure size 1100x900 with 6 Axes>"
      ],
      "image/png": "\n"
     },
     "metadata": {}
    }
   ],
   "source": [
    "for nazwa, y in nagrania.items():\n",
    "    S_db, M = cechy[nazwa]\n",
    "    skala = np.abs(M[1:]).max()\n",
    "    fig, ax = plt.subplots(3, 2, figsize=(11, 9),\n",
    "                           gridspec_kw={\"width_ratios\": [40, 1]})\n",
    "    librosa.display.waveshow(y, sr=SR, ax=ax[0, 0])\n",
    "    ax[0, 1].axis(\"off\")\n",
    "    img = librosa.display.specshow(S_db, sr=SR, hop_length=HOP_LENGTH,\n",
    "                                   x_axis=\"time\", y_axis=\"mel\",\n",
    "                                   vmin=-80, vmax=0, ax=ax[1, 0])\n",
    "    fig.colorbar(img, cax=ax[1, 1], format=\"%+2.0f dB\")\n",
    "    img = librosa.display.specshow(M, sr=SR, hop_length=HOP_LENGTH,\n",
    "                                   x_axis=\"time\", cmap=\"coolwarm\",\n",
    "                                   vmin=-skala, vmax=skala, ax=ax[2, 0])\n",
    "    fig.colorbar(img, cax=ax[2, 1])\n",
    "    ax[0, 0].set(title=f\"{OPIS[nazwa]} - przebieg czasowy\",\n",
    "                 ylabel=\"amplituda\")\n",
    "    ax[1, 0].set(title=\"log-mel (64 pasma)\", ylabel=\"częstotliwość [Hz]\")\n",
    "    ax[2, 0].set(title=\"MFCC (13 współczynników)\",\n",
    "                 ylabel=\"nr współczynnika\", yticks=range(0, N_MFCC, 2))\n",
    "    for a in ax[:, 0]:\n",
    "        a.set(xlim=zakres_wykresu(y), xlabel=\"czas [s]\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
