    "fig.colorbar(img, ax=ax, format=\"%+2.0f dB\")\n",
    "plt.show()\n",
    "\n",
    "for nazwa, y in nagrania.items():\n",
    "    for hop in WARTOSCI_HOP:\n",
    "        S_db = log_mel(y, hop_length=hop)\n",
    "        print(f\"{OPIS[nazwa]}, hop_length = {hop}: log-mel {S_db.shape}, \"\n",
    "              f\"MFCC {mfcc(S_db).shape}, \"\n",
    "              f\"1 + {len(y)} // {hop} = {1 + len(y) // hop}\")"
   ]
